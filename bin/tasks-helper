#!/usr/bin/env python3
"""
Google Tasks Helper for Omarchy Quattro
Communicates via structured bounded JSON over stdin.
Zero external dependencies (pure Python standard library).
"""

import sys
import os
import stat
import errno
import secrets
import json
import time
import urllib.request
import urllib.parse
import urllib.error
import http.server
import socketserver
import webbrowser
import threading

MAX_STDIN_BYTES = 65536
MAX_FILE_BYTES = 65536
MAX_RESPONSE_BYTES = 256 * 1024
MAX_HTTP_ERROR_BYTES = 4096
NETWORK_TIMEOUT = 15

MAX_TASK_LISTS = 25
MAX_TASKS = 50
MAX_TITLE_LEN = 300
MAX_NOTES_LEN = 1000
MAX_LIST_TITLE_LEN = 100
MAX_ERROR_LEN = 250

DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_CLOEXEC", 0) | os.O_NOFOLLOW
FILE_READ_FLAGS = os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_CLOEXEC", 0) | os.O_NOFOLLOW

# Storage directories (prefers user-owned non-symlinked state dir)
STATE_DIR = os.path.expanduser("~/.local/state/omarchy/cjkaufman.google-tasks")
CONFIG_DIR = os.path.expanduser("~/.config/omarchy/cjkaufman.google-tasks")


def validate_directory(st, label, is_final=False):
    """Ensure directory descriptor is a directory, not group/world writable, and owned properly."""
    uid = os.getuid()
    if not stat.S_ISDIR(st.st_mode):
        raise OSError(errno.ENOTDIR, f"Not a directory: {label}")
    if st.st_uid not in (0, uid):
        raise OSError(errno.EACCES, f"Unexpected owner for {label}: uid={st.st_uid}")
    if is_final and st.st_uid != uid:
        raise OSError(errno.EACCES, f"Final directory not owned by current user: {label}")
    if (st.st_mode & (stat.S_IWGRP | stat.S_IWOTH)) and not (st.st_uid == 0 and bool(st.st_mode & stat.S_ISVTX)):
        raise OSError(errno.EACCES, f"Directory is group/world writable: {label}")


def open_dir_safe(path, create=False):
    """Walk and open directory descriptor component-by-component with strict O_NOFOLLOW."""
    components = [p for p in os.path.normpath(path).split("/") if p]
    current = os.open("/", DIR_FLAGS)
    label = ""
    try:
        validate_directory(os.fstat(current), "/")
        for i, comp in enumerate(components):
            label += "/" + comp
            is_final = (i == len(components) - 1)
            try:
                following = os.open(comp, DIR_FLAGS, dir_fd=current)
            except FileNotFoundError:
                if not create:
                    raise
                validate_directory(os.fstat(current), os.path.dirname(label), is_final=False)
                os.mkdir(comp, 0o700, dir_fd=current)
                following = os.open(comp, DIR_FLAGS, dir_fd=current)
            except OSError as exc:
                if exc.errno in (errno.ELOOP, errno.ENOTDIR):
                    raise OSError(errno.ELOOP, f"Refusing symlink or non-directory at {label}") from exc
                raise
            os.close(current)
            current = following
            validate_directory(os.fstat(current), label, is_final=is_final)
        return current
    except Exception:
        os.close(current)
        raise


def get_data_dir():
    """Return verified private storage directory refusing symlinked directory components."""
    for d in [STATE_DIR, CONFIG_DIR]:
        try:
            fd = open_dir_safe(d, create=False)
            os.close(fd)
            return d
        except Exception:
            continue
    try:
        fd = open_dir_safe(STATE_DIR, create=True)
        os.close(fd)
        return STATE_DIR
    except Exception:
        return STATE_DIR


def safe_read_file(dir_fd, filename, max_bytes=MAX_FILE_BYTES):
    """Read a file safely: O_NOFOLLOW, non-blocking, regular file only, owned by user, bounded read."""
    try:
        fd = os.open(filename, FILE_READ_FLAGS, dir_fd=dir_fd)
    except (FileNotFoundError, OSError):
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise OSError(errno.EINVAL, f"Not a regular file: {filename}")
        if st.st_uid != os.getuid():
            raise OSError(errno.EACCES, f"File not owned by user: {filename}")
        if st.st_nlink != 1:
            raise OSError(errno.EINVAL, f"File has unexpected link count: {filename}")
        if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            raise OSError(errno.EACCES, f"File is group/world writable: {filename}")
        if st.st_size > max_bytes:
            raise OSError(errno.EFBIG, f"File exceeds size limit ({max_bytes} bytes): {filename}")

        os.set_blocking(fd, True)
        chunks = []
        total = 0
        while True:
            chunk = os.read(fd, min(65536, max_bytes + 1 - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
            if total > max_bytes:
                raise OSError(errno.EFBIG, f"File exceeds size limit ({max_bytes} bytes): {filename}")
        return b"".join(chunks)
    finally:
        os.close(fd)


def safe_read_json(dir_path, filename):
    """Safely read and parse JSON file from a directory with descriptor traversal."""
    try:
        dir_fd = open_dir_safe(dir_path, create=False)
    except Exception:
        return None
    try:
        data = safe_read_file(dir_fd, filename, MAX_FILE_BYTES)
        if not data:
            return None
        return json.loads(data.decode("utf-8"))
    except Exception:
        return None
    finally:
        os.close(dir_fd)


def safe_write_json(dir_path, filename, obj):
    """Atomically write JSON with 0o600 creation mode, O_NOFOLLOW, and fsync."""
    payload = json.dumps(obj, indent=2).encode("utf-8")
    if len(payload) > MAX_FILE_BYTES:
        raise ValueError(f"Payload exceeds {MAX_FILE_BYTES} bytes")

    dir_fd = open_dir_safe(dir_path, create=True)
    temp_name = f".{filename}.tmp.{os.getpid()}.{secrets.token_hex(8)}"
    temp_fd = -1
    try:
        temp_fd = os.open(
            temp_name,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0) | os.O_NOFOLLOW,
            0o600,
            dir_fd=dir_fd
        )
        st = os.fstat(temp_fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid():
            raise OSError(errno.EACCES, "Invalid temporary file stat")

        view = memoryview(payload)
        while view:
            written = os.write(temp_fd, view)
            if written <= 0:
                raise OSError(errno.EIO, "Short write to temp file")
            view = view[written:]
        os.fsync(temp_fd)
        os.close(temp_fd)
        temp_fd = -1

        os.replace(temp_name, filename, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
        temp_name = ""
        os.fsync(dir_fd)
    finally:
        if temp_fd >= 0:
            os.close(temp_fd)
        if temp_name:
            try:
                os.unlink(temp_name, dir_fd=dir_fd)
            except FileNotFoundError:
                pass
        os.close(dir_fd)


def safe_remove_file(dir_path, filename):
    """Safely remove a file relative to a verified directory descriptor."""
    try:
        dir_fd = open_dir_safe(dir_path, create=False)
    except Exception:
        return
    try:
        os.unlink(filename, dir_fd=dir_fd)
    except FileNotFoundError:
        pass
    finally:
        os.close(dir_fd)


def load_config():
    cfg = safe_read_json(get_data_dir(), "config.json")
    if cfg and isinstance(cfg, dict) and cfg.get("client_id") and cfg.get("client_secret"):
        return cfg
    data = safe_read_json(get_data_dir(), "client_secret.json")
    if data and isinstance(data, dict):
        installed = data.get("installed", data.get("web", {}))
        if installed and isinstance(installed, dict):
            return {
                "client_id": str(installed.get("client_id", "")).strip(),
                "client_secret": str(installed.get("client_secret", "")).strip()
            }
    return {}


def save_config(client_id, client_secret):
    config = {"client_id": str(client_id).strip(), "client_secret": str(client_secret).strip()}
    safe_write_json(get_data_dir(), "config.json", config)
    return config


def load_token():
    tok = safe_read_json(get_data_dir(), "token.json")
    if tok and isinstance(tok, dict):
        return tok
    return None


def save_token(token_data):
    safe_write_json(get_data_dir(), "token.json", token_data)


def load_cache():
    cache = safe_read_json(get_data_dir(), "cache.json")
    if cache and isinstance(cache, dict):
        return cache
    return {"lists": [], "tasks_by_list": {}}


def save_cache(cache_obj):
    try:
        safe_write_json(get_data_dir(), "cache.json", cache_obj)
    except Exception:
        pass


def bounded_read_stream(stream, limit):
    """Read a network/response stream up to `limit` bytes, throwing if exceeded."""
    chunks = []
    total = 0
    while True:
        chunk = stream.read(min(65536, limit + 1 - total))
        if not chunk:
            break
        chunks.append(chunk)
        total += len(chunk)
        if total > limit:
            raise RuntimeError(f"Network response exceeded producer limit of {limit} bytes")
    return b"".join(chunks)


def refresh_access_token(token_data, client_id, client_secret):
    refresh_token = token_data.get("refresh_token")
    if not refresh_token:
        raise ValueError("No refresh_token found in saved credentials.")
    
    url = "https://oauth2.googleapis.com/token"
    payload = urllib.parse.urlencode({
        "client_id": client_id,
        "client_secret": client_secret,
        "refresh_token": refresh_token,
        "grant_type": "refresh_token"
    }).encode("utf-8")
    
    req = urllib.request.Request(url, data=payload, headers={"Content-Type": "application/x-www-form-urlencoded"})
    try:
        with urllib.request.urlopen(req, timeout=NETWORK_TIMEOUT) as resp:
            raw = bounded_read_stream(resp, MAX_RESPONSE_BYTES)
            res_data = json.loads(raw.decode("utf-8", errors="replace"))
            token_data["access_token"] = res_data["access_token"]
            token_data["expires_at"] = time.time() + res_data.get("expires_in", 3600)
            save_token(token_data)
            return token_data["access_token"]
    except urllib.error.HTTPError as e:
        err_bytes = bounded_read_stream(e, MAX_HTTP_ERROR_BYTES)
        err_msg = err_bytes.decode("utf-8", errors="replace")
        if "invalid_grant" in err_msg:
            try:
                safe_remove_file(get_data_dir(), "token.json")
            except Exception:
                pass
        raise RuntimeError(f"Token refresh failed: {err_msg}"[:MAX_ERROR_LEN])
    except urllib.error.URLError as e:
        raise RuntimeError(f"Network error during token refresh: {e.reason}"[:MAX_ERROR_LEN])


def get_valid_access_token(force_refresh=False):
    config = load_config()
    client_id = config.get("client_id") or os.environ.get("GOOGLE_TASKS_CLIENT_ID")
    client_secret = config.get("client_secret") or os.environ.get("GOOGLE_TASKS_CLIENT_SECRET")
    
    if not client_id or not client_secret:
        raise ValueError("Google Client ID and Secret are not configured. Run auth setup first.")
    
    token_data = load_token()
    if not token_data:
        raise ValueError("Not authenticated. Please run the login/auth flow.")
    
    expires_at = token_data.get("expires_at", 0)
    if not force_refresh and time.time() < (expires_at - 60) and token_data.get("access_token"):
        return token_data["access_token"]
    
    return refresh_access_token(token_data, client_id, client_secret)


def api_request(endpoint, method="GET", body=None, params=None, retry_on_401=True):
    token = get_valid_access_token()
    url = f"https://tasks.googleapis.com/tasks/v1{endpoint}"
    if params:
        url += "?" + urllib.parse.urlencode(params)
    
    headers = {
        "Authorization": f"Bearer {token}",
        "Content-Type": "application/json"
    }
    data = json.dumps(body).encode("utf-8") if body is not None else None
    
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=NETWORK_TIMEOUT) as resp:
            raw = bounded_read_stream(resp, MAX_RESPONSE_BYTES)
            if not raw:
                return {}
            return json.loads(raw.decode("utf-8", errors="replace"))
    except urllib.error.HTTPError as e:
        if e.code == 401 and retry_on_401:
            try:
                get_valid_access_token(force_refresh=True)
                return api_request(endpoint, method=method, body=body, params=params, retry_on_401=False)
            except Exception:
                pass
        err_bytes = bounded_read_stream(e, MAX_HTTP_ERROR_BYTES)
        err_msg = err_bytes.decode("utf-8", errors="replace")
        try:
            err_json = json.loads(err_msg)
            msg = err_json.get("error", {}).get("message", err_msg)
            raise RuntimeError(msg[:MAX_ERROR_LEN])
        except Exception:
            raise RuntimeError(f"HTTP {e.code}: {err_msg}"[:MAX_ERROR_LEN])
    except urllib.error.URLError as e:
        raise RuntimeError(f"Network error: {e.reason}"[:MAX_ERROR_LEN])


class OAuthCallbackHandler(http.server.BaseHTTPRequestHandler):
    auth_code = None
    error = None

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        params = urllib.parse.parse_qs(parsed.query)
        if "code" in params:
            OAuthCallbackHandler.auth_code = params["code"][0]
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            html = """
            <!DOCTYPE html>
            <html>
            <head><title>Authentication Successful</title>
            <style>
              body { font-family: system-ui, -apple-system, sans-serif; background: #121214; color: #e1e1e6; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }
              .card { background: #202024; padding: 2rem; border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.5); text-align: center; max-width: 400px; }
              h1 { color: #4ade80; margin-bottom: 0.5rem; }
              p { color: #a1a1aa; line-height: 1.5; }
            </style>
            </head>
            <body>
              <div class="card">
                <h1>✓ Success!</h1>
                <p>Google Tasks authentication completed successfully.</p>
                <p>You can close this tab and return to Omarchy.</p>
              </div>
            </body>
            </html>
            """
            self.wfile.write(html.encode("utf-8"))
        else:
            OAuthCallbackHandler.error = params.get("error", ["Unknown error"])[0]
            self.send_response(400)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(b"<h1>Authentication Failed</h1><p>Please try again.</p>")

    def log_message(self, format, *args):
        pass


def run_oauth_flow(client_id, client_secret, port=8765):
    redirect_uri = f"http://127.0.0.1:{port}/callback"
    scope = "https://www.googleapis.com/auth/tasks"
    
    auth_url = (
        "https://accounts.google.com/o/oauth2/v2/auth?" +
        urllib.parse.urlencode({
            "client_id": client_id,
            "redirect_uri": redirect_uri,
            "response_type": "code",
            "scope": scope,
            "access_type": "offline",
            "prompt": "consent"
        })
    )
    
    server = socketserver.TCPServer(("127.0.0.1", port), OAuthCallbackHandler)
    server_thread = threading.Thread(target=server.handle_request)
    server_thread.daemon = True
    server_thread.start()
    
    webbrowser.open(auth_url)
    
    server_thread.join(timeout=120)
    server.server_close()
    
    code = OAuthCallbackHandler.auth_code
    if not code:
        raise RuntimeError(f"Authentication timed out or failed: {OAuthCallbackHandler.error}"[:MAX_ERROR_LEN])
    
    url = "https://oauth2.googleapis.com/token"
    payload = urllib.parse.urlencode({
        "client_id": client_id,
        "client_secret": client_secret,
        "code": code,
        "grant_type": "authorization_code",
        "redirect_uri": redirect_uri
    }).encode("utf-8")
    
    req = urllib.request.Request(url, data=payload, headers={"Content-Type": "application/x-www-form-urlencoded"})
    try:
        with urllib.request.urlopen(req, timeout=NETWORK_TIMEOUT) as resp:
            raw = bounded_read_stream(resp, MAX_RESPONSE_BYTES)
            res_data = json.loads(raw.decode("utf-8", errors="replace"))
            res_data["expires_at"] = time.time() + res_data.get("expires_in", 3600)
            save_token(res_data)
            save_config(client_id, client_secret)
            return res_data
    except urllib.error.HTTPError as e:
        err_bytes = bounded_read_stream(e, MAX_HTTP_ERROR_BYTES)
        err_msg = err_bytes.decode("utf-8", errors="replace")
        raise RuntimeError(f"OAuth code exchange failed: {err_msg}"[:MAX_ERROR_LEN])
    except urllib.error.URLError as e:
        raise RuntimeError(f"Network error during OAuth: {e.reason}"[:MAX_ERROR_LEN])


def handle_action(req):
    action = req.get("action", "")

    if action == "status":
        cfg = load_config()
        tok = load_token()
        return {
            "configured": bool(cfg.get("client_id") and cfg.get("client_secret")),
            "authenticated": bool(tok and tok.get("refresh_token")),
            "client_id": cfg.get("client_id", ""),
            "client_secret": cfg.get("client_secret", ""),
            "config_dir": get_data_dir()
        }

    elif action == "auth":
        cfg = load_config()
        client_id = req.get("client_id") or cfg.get("client_id")
        client_secret = req.get("client_secret") or cfg.get("client_secret")
        port = int(req.get("port", 8765))
        if not client_id or not client_secret:
            raise ValueError("Missing client_id or client_secret")
        run_oauth_flow(str(client_id).strip(), str(client_secret).strip(), port)
        return {"status": "ok", "authenticated": True}

    elif action == "logout":
        safe_remove_file(get_data_dir(), "token.json")
        return {"status": "ok", "message": "Logged out"}

    elif action == "get-cache":
        return load_cache()

    elif action == "list-lists":
        res = api_request("/users/@me/lists", params={"maxResults": str(MAX_TASK_LISTS)})
        lists = []
        for item in res.get("items", [])[:MAX_TASK_LISTS]:
            lists.append({
                "id": str(item.get("id", ""))[:100],
                "title": str(item.get("title", ""))[:MAX_LIST_TITLE_LEN]
            })
        cache = load_cache()
        cache["lists"] = lists
        save_cache(cache)
        return lists

    elif action == "create-list":
        title = str(req.get("title", "")).strip()[:MAX_LIST_TITLE_LEN]
        if not title:
            raise ValueError("Missing title")
        res = api_request("/users/@me/lists", method="POST", body={"title": title})
        new_list = {
            "id": str(res.get("id", ""))[:100],
            "title": str(res.get("title", ""))[:MAX_LIST_TITLE_LEN]
        }
        cache = load_cache()
        if "lists" in cache and isinstance(cache["lists"], list):
            cache["lists"].append(new_list)
            save_cache(cache)
        return new_list

    elif action == "delete-list":
        list_id = str(req.get("list_id", "")).strip()
        if not list_id or list_id == "@default":
            raise ValueError("Invalid list_id")
        api_request(f"/users/@me/lists/{list_id}", method="DELETE")
        cache = load_cache()
        if "lists" in cache and isinstance(cache["lists"], list):
            cache["lists"] = [l for l in cache["lists"] if l.get("id") != list_id]
            if "tasks_by_list" in cache and isinstance(cache["tasks_by_list"], dict) and list_id in cache["tasks_by_list"]:
                del cache["tasks_by_list"][list_id]
            save_cache(cache)
        return {"status": "ok", "deleted": list_id}

    elif action == "list-tasks":
        list_id = str(req.get("list_id", "")).strip() or "@default"
        show_completed = bool(req.get("show_completed", False))
        params = {
            "showCompleted": "true" if show_completed else "false",
            "showHidden": "false",
            "maxResults": str(MAX_TASKS)
        }
        res = api_request(f"/lists/{list_id}/tasks", params=params)
        items = []
        for item in res.get("items", [])[:MAX_TASKS]:
            if item.get("deleted"):
                continue
            items.append({
                "id": str(item.get("id", ""))[:100],
                "title": str(item.get("title", ""))[:MAX_TITLE_LEN],
                "notes": str(item.get("notes", ""))[:MAX_NOTES_LEN],
                "status": "completed" if item.get("status") == "completed" else "needsAction",
                "due": str(item.get("due", ""))[:50],
                "completed": str(item.get("completed", ""))[:50],
                "updated": str(item.get("updated", ""))[:50]
            })
        cache = load_cache()
        if "tasks_by_list" not in cache or not isinstance(cache["tasks_by_list"], dict):
            cache["tasks_by_list"] = {}
        cache["tasks_by_list"][list_id] = items
        save_cache(cache)
        return items

    elif action == "create-task":
        list_id = str(req.get("list_id", "")).strip() or "@default"
        title = str(req.get("title", "")).strip()[:MAX_TITLE_LEN]
        if not title:
            raise ValueError("Missing title")
        body = {"title": title}
        if req.get("notes"):
            body["notes"] = str(req.get("notes"))[:MAX_NOTES_LEN]
        if req.get("due"):
            body["due"] = str(req.get("due"))[:50]
        res = api_request(f"/lists/{list_id}/tasks", method="POST", body=body)
        return {
            "id": str(res.get("id", ""))[:100],
            "title": str(res.get("title", ""))[:MAX_TITLE_LEN],
            "status": str(res.get("status", "needsAction")),
            "due": str(res.get("due", ""))[:50]
        }

    elif action == "update-task":
        list_id = str(req.get("list_id", "")).strip() or "@default"
        task_id = str(req.get("task_id", "")).strip()
        if not task_id:
            raise ValueError("Missing task_id")
        body = {"id": task_id}
        if "title" in req:
            body["title"] = str(req["title"]).strip()[:MAX_TITLE_LEN]
        if "notes" in req:
            body["notes"] = str(req["notes"])[:MAX_NOTES_LEN]
        if "due" in req:
            due_val = req["due"]
            body["due"] = str(due_val)[:50] if due_val else None
        res = api_request(f"/lists/{list_id}/tasks/{task_id}", method="PATCH", body=body)
        return {
            "id": str(res.get("id", ""))[:100],
            "title": str(res.get("title", ""))[:MAX_TITLE_LEN],
            "notes": str(res.get("notes", ""))[:MAX_NOTES_LEN],
            "status": str(res.get("status", "needsAction")),
            "due": str(res.get("due", ""))[:50],
            "updated": str(res.get("updated", ""))[:50]
        }

    elif action == "complete-task":
        list_id = str(req.get("list_id", "")).strip() or "@default"
        task_id = str(req.get("task_id", "")).strip()
        if not task_id:
            raise ValueError("Missing task_id")
        body = {"id": task_id, "status": "completed"}
        api_request(f"/lists/{list_id}/tasks/{task_id}", method="PATCH", body=body)
        return {"status": "ok", "id": task_id}

    elif action == "uncomplete-task":
        list_id = str(req.get("list_id", "")).strip() or "@default"
        task_id = str(req.get("task_id", "")).strip()
        if not task_id:
            raise ValueError("Missing task_id")
        body = {"id": task_id, "status": "needsAction", "completed": None}
        api_request(f"/lists/{list_id}/tasks/{task_id}", method="PATCH", body=body)
        return {"status": "ok", "id": task_id}

    elif action == "clear-completed":
        list_id = str(req.get("list_id", "")).strip() or "@default"
        api_request(f"/lists/{list_id}/clear", method="POST")
        return {"status": "ok", "list_id": list_id}

    elif action == "delete-task":
        list_id = str(req.get("list_id", "")).strip() or "@default"
        task_id = str(req.get("task_id", "")).strip()
        if not task_id:
            raise ValueError("Missing task_id")
        api_request(f"/lists/{list_id}/tasks/{task_id}", method="DELETE")
        return {"status": "ok", "deleted": task_id}

    else:
        raise ValueError(f"Unknown action: {action}")


def main():
    # Read bounded payload from stdin if available, or parse action argument
    if len(sys.argv) > 1 and sys.argv[1] == "status":
        # Fast status check without stdin requirement
        cfg = load_config()
        tok = load_token()
        out = {
            "configured": bool(cfg.get("client_id") and cfg.get("client_secret")),
            "authenticated": bool(tok and tok.get("refresh_token")),
            "client_id": cfg.get("client_id", ""),
            "client_secret": cfg.get("client_secret", ""),
            "config_dir": get_data_dir()
        }
        print(json.dumps(out))
        return

    # Read single line JSON from stdin (bounded to MAX_STDIN_BYTES)
    raw_input = sys.stdin.readline(MAX_STDIN_BYTES)
    if not raw_input or not raw_input.strip():
        print(json.dumps({"error": "Empty stdin payload"}), file=sys.stderr)
        sys.exit(1)

    try:
        req = json.loads(raw_input)
        result = handle_action(req)
        print(json.dumps(result))
    except Exception as e:
        err_msg = str(e)[:MAX_ERROR_LEN]
        print(json.dumps({"error": err_msg}), file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
